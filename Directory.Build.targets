<?xml version="1.0" encoding="UTF-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <!--
      Polyfill 11 emits unsuffixed Polyfills.Polyfill. ILRepacking more than one
      copy — or later /union-merging with another consumer — smashes metadata;
      CoreCLR 10 rejects the image (BadImageFormatException: Invalid token).
      This file is imported by every project that walks up to the repo root,
      including submodule projects that have no Directory.Build.targets of
      their own. Keep Polyfill on net48 only.
    -->
    <ItemGroup Condition="'$(TargetFramework)' != '' AND !$(TargetFramework.StartsWith('net4'))">
        <PackageReference Remove="Polyfill"/>
        <GlobalPackageReference Remove="Polyfill"/>
    </ItemGroup>

    <Target Name="StripPolyfillOnModernTfm"
            BeforeTargets="ResolvePackageAssets;ResolveAssemblyReferences;CoreCompile"
            Condition="'$(TargetFramework)' != '' AND !$(TargetFramework.StartsWith('net4'))">
        <ItemGroup>
            <PackageReference Remove="Polyfill"/>
            <Analyzer Remove="@(Analyzer)"
                      Condition="$([System.String]::Copy('%(Identity)').IndexOf('Polyfill', System.StringComparison.OrdinalIgnoreCase)) &gt;= 0"/>
        </ItemGroup>
    </Target>

</Project>
