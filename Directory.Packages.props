<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <!-- Microsoft -->
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14"/>
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.14"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14"/>
        <PackageVersion Include="System.Threading.Channels" Version="10.0.14"/>
        <PackageVersion Include="System.Text.Json" Version="10.0.14"/>
        <!-- Utilities -->
        <PackageVersion Include="Polyfill" Version="11.4.5"/>
        <!-- Logging -->
        <PackageVersion Include="Scintilla5.NET" Version="7.1.1"/>
        <PackageVersion Include="Zlogger" Version="2.6.1"/>
        <PackageVersion Include="Serilog.Sinks.RichTextBox.WinForms.Colored" Version="3.2.1"/>
        <PackageVersion Include="Serilog" Version="4.4.0"/>
        <!-- Build -->
        <PackageVersion Include="JetBrains.Annotations.Sources" Version="2026.2.0"/>
        <!-- Benchmark -->
        <PackageVersion Include="BenchmarkDotNet" Version="0.15.8"/>
    </ItemGroup>
</Project>

