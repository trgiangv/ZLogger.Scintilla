<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
        <UseWPF>true</UseWPF>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <UseWindowsForms>true</UseWindowsForms>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Keeps this assembly's internal polyfills from being visible through InternalsVisibleTo. -->
        <PolyUseEmbeddedAttribute>true</PolyUseEmbeddedAttribute>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>ZLogger.Scintilla</PackageId>
        <Version>0.1.0</Version>
        <Authors>trgiangv</Authors>
        <Description>Log viewer control for WinForms and WPF that shows ZLogger output color-coded, with level filtering, search, clickable links and pretty-printed JSON. Built on Scintilla.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/trgiangv/ZLogger.Scintilla</PackageProjectUrl>
        <RepositoryUrl>https://github.com/trgiangv/ZLogger.Scintilla</RepositoryUrl>
        <PackageTags>zlogger;scintilla;logging;viewer;winforms;wpf</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
        <None Include="buildTransitive\ZLogger.Scintilla.targets" Pack="true" PackagePath="buildTransitive\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Logging"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
        <PackageReference Include="Polyfill" Condition="$(TargetFramework.StartsWith('net4'))">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- Part of the runtime on modern targets, so only net48 needs them as packages. -->
        <PackageReference Include="System.Threading.Channels" Condition="$(TargetFramework.StartsWith('net4'))"/>
        <!-- ZLogger asks for an older version than LookupEngine needs, and net48 apps get what is declared here. -->
        <PackageReference Include="System.Text.Json" Condition="$(TargetFramework.StartsWith('net4'))"/>
        <!-- Scintilla5.NET delivers its native DLLs to net48 apps through a build target, which NuGet
             excludes from transitive dependencies unless the dependency keeps its build assets. -->
        <PackageReference Include="Scintilla5.NET" PrivateAssets="none"/>
        <PackageReference Include="Zlogger"/>
    </ItemGroup>

    <!-- On net48, Utf8StringInterpolation (from ZLogger) already exposes System.Buffers.ArrayBufferWriter<T>, so
         Polyfill's copy would only shadow it (CS0436). Using the imported one also matches the type ZLogger uses. -->
    <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
        <Compile Remove="$(NuGetPackageRoot)polyfill\*\contentFiles\cs\*\ArrayBufferWriter.cs"/>
    </ItemGroup>

    <!-- LookupEngine compiles into this assembly as source. Its JetBrains attributes are [Conditional],
         so they are compile-time only. -->
    <ItemGroup>
        <Compile Include="..\external\LookupEngine\source\LookupEngine\**\*.cs;..\external\LookupEngine\source\LookupEngine.Abstractions\**\*.cs"
                 Exclude="..\external\LookupEngine\source\*\bin\**;..\external\LookupEngine\source\*\obj\**"
                 Link="LookupEngine\%(RecursiveDir)%(Filename)%(Extension)"/>
        <PackageReference Include="JetBrains.Annotations" PrivateAssets="all" ExcludeAssets="runtime"/>
        <Using Include="JetBrains.Annotations"/>
    </ItemGroup>

    <!-- The usings LookupEngine's source expects from its own project settings. Added by hand rather than with
         ImplicitUsings, which would also bring System.Windows.Forms and System.Drawing into its files. -->
    <ItemGroup>
        <Using Include="System"/>
        <Using Include="System.Collections.Generic"/>
        <Using Include="System.IO"/>
        <Using Include="System.Linq"/>
        <Using Include="System.Threading"/>
        <Using Include="System.Threading.Tasks"/>
    </ItemGroup>

</Project>
