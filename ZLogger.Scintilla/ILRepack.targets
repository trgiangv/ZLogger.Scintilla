<?xml version="1.0" encoding="UTF-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <PropertyGroup>
        <!-- Opt-in merge. Needs PackageReference ILRepack.Lib.MSBuild.Task on the csproj. -->
        <IsRepackable Condition="'$(IsRepackable)' == ''">false</IsRepackable>
        <ILRepackInternalize Condition="'$(ILRepackInternalize)' == ''">false</ILRepackInternalize>
        <ILRepackUnion Condition="'$(ILRepackUnion)' == ''">false</ILRepackUnion>
        <ILRepackParallel Condition="'$(ILRepackParallel)' == ''">false</ILRepackParallel>
    </PropertyGroup>

    <!-- Merge copy-local project outputs into the primary assembly. NuGet package
         DLLs stay beside the output (PackageReference dependencies of the nupkg). -->
    <Target Name="RepackAssemblies"
            AfterTargets="Build"
            Condition="'$(IsRepackable)' == 'true' AND '$(TargetFramework)' != '' AND '$(TargetPath)' != ''">

        <ItemGroup>
            <_ILRepackExcludeNames Include="$(RepackBinariesExcludes.Split(';'))"
                                   Condition="'$(RepackBinariesExcludes)' != ''"/>
            <_ILRepackExclude Include="$(TargetDir)%(_ILRepackExcludeNames.Identity)"/>
            <_ILRepackCopyLocal Include="@(_ResolvedProjectReferencePaths)"
                                Condition="'%(Extension)' == '.dll' AND '%(Filename)' != '$(AssemblyName)'"/>
            <_ILRepackCopyLocal Include="@(ReferenceCopyLocalPaths)"
                                Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'
                                           AND '%(ReferenceCopyLocalPaths.NuGetPackageId)' == ''
                                           AND '%(ReferenceCopyLocalPaths.Filename)' != '$(AssemblyName)'"/>
            <_ILRepackInput Include="$(TargetPath)"/>
            <_ILRepackCandidate Include="$(TargetDir)%(_ILRepackCopyLocal.Filename)%(_ILRepackCopyLocal.Extension)"
                                Exclude="@(_ILRepackExclude);$(TargetPath)"
                                Condition="Exists('$(TargetDir)%(_ILRepackCopyLocal.Filename)%(_ILRepackCopyLocal.Extension)')"/>
            <_ILRepackInput Include="@(_ILRepackCandidate->Distinct())"/>
        </ItemGroup>

        <Message Text="Repacking $(TargetPath) inputs=@(_ILRepackInput)" Importance="high"/>

        <ILRepack
            Internalize="$(ILRepackInternalize)"
            Union="$(ILRepackUnion)"
            AllowDuplicateResources="false"
            DebugInfo="true"
            InputAssemblies="@(_ILRepackInput)"
            LibraryPath="$(TargetDir)"
            OutputFile="$(TargetPath)"
            Parallel="$(ILRepackParallel)"
            TargetKind="SameAsPrimaryAssembly"/>

        <ItemGroup>
            <_ILRepackedFiles Include="@(_ILRepackInput->'%(RootDir)%(Directory)%(Filename).dll')"
                              Condition="%(Filename) != $(AssemblyName)"/>
            <_ILRepackedFiles Include="@(_ILRepackInput->'%(RootDir)%(Directory)%(Filename).pdb')"
                              Condition="%(Filename) != $(AssemblyName)"/>
        </ItemGroup>
        <Delete Files="@(_ILRepackedFiles)"/>
    </Target>

</Project>
